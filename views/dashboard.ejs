<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - <%= shop %></title>

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Navigation Bar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/dashboard">
        <i class="bi bi-graph-up-arrow"></i> Product Analytics
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <span class="navbar-text text-white-50 me-3">
              <i class="bi bi-shop"></i> <%= shop %>
            </span>
          </li>
          <li class="nav-item">
            <button class="btn btn-success btn-sm me-2" id="syncBtn">
              <i class="bi bi-arrow-clockwise"></i> Sync Now
            </button>
          </li>
          <li class="nav-item">
            <a class="btn btn-outline-light btn-sm" href="/auth/logout">
              <i class="bi bi-box-arrow-right"></i> Logout
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container-fluid py-4">
    <!-- Last Sync Info -->
    <div class="row mb-3">
      <div class="col-12">
        <div class="alert alert-info alert-dismissible fade show" role="alert">
          <i class="bi bi-info-circle"></i>
          <strong>Last Sync:</strong>
          <% if (lastSync) { %>
            <%= new Date(lastSync).toLocaleString() %>
          <% } else { %>
            Never - Click "Sync Now" to fetch products
          <% } %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
      <div class="col-md-3 mb-3">
        <div class="card text-white bg-primary">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="card-title text-uppercase small">Total Products</h6>
                <h2 class="mb-0"><%= stats.totalProducts %></h2>
              </div>
              <div class="fs-1"><i class="bi bi-box-seam"></i></div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-3 mb-3">
        <div class="card text-white bg-success">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="card-title text-uppercase small">Active Products</h6>
                <h2 class="mb-0"><%= stats.activeProducts %></h2>
              </div>
              <div class="fs-1"><i class="bi bi-check-circle"></i></div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-3 mb-3">
        <div class="card text-white bg-info">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="card-title text-uppercase small">Total Inventory</h6>
                <h2 class="mb-0"><%= stats.totalInventory %></h2>
              </div>
              <div class="fs-1"><i class="bi bi-stack"></i></div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-3 mb-3">
        <div class="card text-white bg-warning">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="card-title text-uppercase small">Low Stock Alerts</h6>
                <h2 class="mb-0"><%= stats.lowStockCount %></h2>
              </div>
              <div class="fs-1"><i class="bi bi-exclamation-triangle"></i></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Charts Row -->
    <div class="row mb-4">
      <div class="col-lg-6 mb-3">
        <div class="card">
          <div class="card-header">
            <i class="bi bi-bar-chart"></i> Top 10 Products by Inventory
          </div>
          <div class="card-body">
            <canvas id="inventoryChart" height="200"></canvas>
          </div>
        </div>
      </div>

      <div class="col-lg-6 mb-3">
        <div class="card">
          <div class="card-header">
            <i class="bi bi-pie-chart"></i> Product Status Distribution
          </div>
          <div class="card-body">
            <canvas id="statusChart" height="200"></canvas>
          </div>
        </div>
      </div>
    </div>

    <!-- Low Stock Alerts -->
    <% if (lowStock && lowStock.length > 0) { %>
    <div class="row mb-4">
      <div class="col-12">
        <div class="card border-warning">
          <div class="card-header bg-warning text-dark">
            <i class="bi bi-exclamation-triangle-fill"></i> Low Stock Alerts (<%= lowStock.length %>)
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-sm table-hover">
                <thead>
                  <tr>
                    <th>Product</th>
                    <th>Vendor</th>
                    <th>Type</th>
                    <th>Stock</th>
                    <th>Price</th>
                  </tr>
                </thead>
                <tbody>
                  <% lowStock.forEach(product => { %>
                  <tr>
                    <td>
                      <% if (product.image_url) { %>
                        <img src="<%= product.image_url %>" alt="<%= product.title %>" class="img-thumbnail me-2" style="width: 40px; height: 40px; object-fit: cover;">
                      <% } %>
                      <strong><%= product.title %></strong>
                    </td>
                    <td><%= product.vendor || '-' %></td>
                    <td><%= product.product_type || '-' %></td>
                    <td>
                      <span class="badge bg-danger"><%= product.inventory_quantity %></span>
                    </td>
                    <td>$<%= parseFloat(product.price).toFixed(2) %></td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Products Table -->
    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <i class="bi bi-table"></i> All Products (<%= totalProducts %>)
              </div>
              <div>
                <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Search products..." style="width: 250px;">
              </div>
            </div>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Product</th>
                    <th>Vendor</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Inventory</th>
                    <th>Price</th>
                    <th>Updated</th>
                  </tr>
                </thead>
                <tbody id="productsTable">
                  <% if (products && products.length > 0) { %>
                    <% products.forEach(product => { %>
                    <tr>
                      <td>
                        <% if (product.image_url) { %>
                          <img src="<%= product.image_url %>" alt="<%= product.title %>" class="img-thumbnail me-2" style="width: 50px; height: 50px; object-fit: cover;">
                        <% } %>
                        <strong><%= product.title %></strong>
                      </td>
                      <td><%= product.vendor || '-' %></td>
                      <td><%= product.product_type || '-' %></td>
                      <td>
                        <span class="badge bg-<%= product.status === 'active' ? 'success' : 'secondary' %>">
                          <%= product.status %>
                        </span>
                      </td>
                      <td>
                        <% if (product.inventory_quantity < 10) { %>
                          <span class="badge bg-danger"><%= product.inventory_quantity %></span>
                        <% } else { %>
                          <%= product.inventory_quantity %>
                        <% } %>
                      </td>
                      <td>$<%= parseFloat(product.price).toFixed(2) %></td>
                      <td><%= new Date(product.updated_at).toLocaleDateString() %></td>
                    </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="7" class="text-center text-muted">
                        No products found. Click "Sync Now" to fetch products from Shopify.
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Dashboard JS -->
  <script>
    // Pass data to JavaScript
    window.dashboardData = {
      topProducts: <%- JSON.stringify(topProducts) %>,
      stats: <%- JSON.stringify(stats) %>
    };
  </script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
