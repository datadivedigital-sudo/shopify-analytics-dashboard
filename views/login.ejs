<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Product Analytics Dashboard' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

  <div class="container">
    <div class="row justify-content-center" style="margin-top: 100px;">
      <div class="col-md-6">

        <!-- App Logo/Header -->
        <div class="text-center mb-4">
          <h1 class="display-4">📊</h1>
          <h2>Product Analytics Dashboard</h2>
          <p class="text-muted">Externally Hosted Shopify App</p>
        </div>

        <!-- Installation Card -->
        <div class="card shadow">
          <div class="card-body p-5">

            <h3 class="card-title text-center mb-4">Install on Your Store</h3>

            <p class="text-center text-muted mb-4">
              Get insights into your products, inventory levels, and sales performance.
            </p>

            <!-- Error Message (if any) -->
            <% if (typeof error !== 'undefined' && error) { %>
              <div class="alert alert-danger" role="alert">
                <%= error %>
              </div>
            <% } %>

            <!-- Installation Form -->
            <form action="/auth" method="GET">
              <div class="mb-3">
                <label for="shop" class="form-label">Your Shop Domain</label>
                <input
                  type="text"
                  class="form-control form-control-lg"
                  id="shop"
                  name="shop"
                  placeholder="yourstore.myshopify.com"
                  required
                  pattern="[a-z0-9-]+\.myshopify\.com"
                  title="Enter your shop domain (e.g., mystore.myshopify.com)"
                >
                <div class="form-text">
                  Enter your complete shop domain ending with .myshopify.com
                </div>
              </div>

              <button type="submit" class="btn btn-primary btn-lg w-100">
                Install App
              </button>
            </form>

          </div>
        </div>

        <!-- Features List -->
        <div class="card mt-4 shadow-sm">
          <div class="card-body">
            <h5 class="card-title mb-3">Features</h5>
            <ul class="list-unstyled">
              <li class="mb-2">✅ Real-time product analytics</li>
              <li class="mb-2">✅ Low inventory alerts</li>
              <li class="mb-2">✅ Sales performance tracking</li>
              <li class="mb-2">✅ Visual charts and graphs</li>
              <li class="mb-2">✅ Automatic data synchronization</li>
            </ul>
          </div>
        </div>

        <!-- Footer -->
        <div class="text-center mt-4 text-muted">
          <small>
            This app requires permissions to read your products, inventory, and orders.
            <br>
            You can review and revoke access anytime in your Shopify admin.
          </small>
        </div>

      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

