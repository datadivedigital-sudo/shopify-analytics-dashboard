# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=your-super-secret-session-key-change-in-production

# Shopify API Credentials
# Get these from Shopify Partner Dashboard → Your App → Configuration
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SCOPES=read_products,read_orders,write_webhooks

# App URL (public accessible URL - use ngrok for development)
# Example: https://abc123.ngrok.io
HOST=https://your-app-url.com

# PostgreSQL Database
# Format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://username:password@localhost:5432/shopify_analytics

# Optional: Storefront API (if needed)
STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Optional: Background Sync (set to true to enable)
ENABLE_AUTO_SYNC=false
